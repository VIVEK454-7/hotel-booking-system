@model BookingViewModel
@{ ViewData["Title"] = "Book your stay"; var nights = Math.Max(1, (Model.CheckOut.Date - Model.CheckIn.Date).Days); }
<section class="page-shell booking-page"><div class="page-heading"><span class="eyebrow">MAKE IT YOURS</span><h1>Book your stay</h1><p>A few details and your next getaway is set.</p></div><div class="booking-layout"><form asp-action="Create" method="post" class="booking-form"><input asp-for="RoomId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><section class="form-section"><span class="step-label">01 / YOUR DETAILS</span><h2>Who's checking in?</h2><div class="two-col"><div><label asp-for="GuestName">Full name</label><input asp-for="GuestName" autocomplete="name"/><span asp-validation-for="GuestName" class="field-error"></span></div><div><label asp-for="GuestEmail">Email address</label><input asp-for="GuestEmail" autocomplete="email"/><span asp-validation-for="GuestEmail" class="field-error"></span></div></div></section><section class="form-section"><span class="step-label">02 / YOUR DATES</span><h2>When are you staying?</h2><div class="two-col"><div><label asp-for="CheckIn"></label><input asp-for="CheckIn" type="date"/><span asp-validation-for="CheckIn" class="field-error"></span></div><div><label asp-for="CheckOut"></label><input asp-for="CheckOut" type="date"/><span asp-validation-for="CheckOut" class="field-error"></span></div></div><div class="guest-field"><label asp-for="Guests">Number of guests</label><select asp-for="Guests"><option value="1">1 guest</option><option value="2">2 guests</option><option value="3">3 guests</option><option value="4">4 guests</option><option value="5">5 guests</option><option value="6">6 guests</option></select><span asp-validation-for="Guests" class="field-error"></span></div></section><button type="submit" class="btn btn-dark btn-wide">Confirm booking <span>↗</span></button><p class="fine-print">This demo confirms bookings immediately and does not process payments.</p></form><aside class="booking-summary"><img src="@((Model.RoomName.Contains("Heritage") ? "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=900&q=85" : "https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=900&q=85"))" alt="Room interior"/><div class="summary-body"><span class="room-category">YOUR SELECTED STAY</span><h3>@Model.RoomName</h3><p>Calm spaces. Thoughtful details. A stay to look forward to.</p><div class="summary-price"><strong>₹@Model.PricePerNight.ToString("N0")</strong><span>/ night</span></div><div class="summary-note">Your final total is calculated from your selected dates and displayed on the confirmation page.</div></div></aside></div></section>
