@model Booking
@{ ViewData["Title"] = "Booking confirmed"; }
<section class="page-shell confirmation-page"><div class="confirmation-card"><div class="success-icon">✓</div><span class="eyebrow">IT'S OFFICIAL</span><h1>Your stay is confirmed.</h1><p class="confirmation-lead">Thanks, @Model.GuestName. Your little escape is on the calendar.</p><div class="booking-number">BOOKING REFERENCE <strong>SE-@Model.Id.ToString("D6")</strong></div><div class="confirm-room"><img src="@Model.Room?.ImageUrl" alt="@Model.Room?.Name"/><div><span class="room-category">@Model.Room?.Category</span><h2>@Model.Room?.Name</h2><p>@Model.Guests guest(s) · @Model.Nights night(s)</p></div></div><div class="confirmation-details"><div><span>CHECK-IN</span><strong>@Model.CheckIn.ToString("ddd, dd MMM yyyy")</strong></div><div><span>CHECK-OUT</span><strong>@Model.CheckOut.ToString("ddd, dd MMM yyyy")</strong></div><div><span>GUEST EMAIL</span><strong>@Model.GuestEmail</strong></div><div><span>BOOKING STATUS</span><strong class="status-pill">@Model.Status</strong></div></div><div class="total-row"><span>Total stay price</span><strong>₹@Model.TotalPrice.ToString("N0")</strong></div><div class="confirmation-actions"><a class="btn btn-dark" asp-action="Mine">View my bookings</a><a class="btn btn-outline" asp-controller="Home" asp-action="Index">Back to explore</a></div><p class="fine-print">This is a booking confirmation for the academic demo. No payment has been taken.</p></div></section>
