<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · StayEase</title>
    <meta name="description" content="Find your place to slow down with StayEase hotel stays." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar"><div class="nav-wrap">
    <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">S</span><span>stay<span class="brand-light">ease</span></span></a>
    <nav class="nav-links"><a asp-controller="Home" asp-action="Index">Explore stays</a>@if (Context.Session.GetInt32("UserId") is not null){<a asp-controller="Bookings" asp-action="Mine">My bookings</a>}</nav>
    <div class="nav-actions">
    @if (Context.Session.GetInt32("UserId") is not null) { <span class="welcome">Hi, @(Context.Session.GetString("UserName")?.Split(' ').FirstOrDefault())</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline btn-small" type="submit">Log out</button></form> }
    else { <a class="login-link" asp-controller="Account" asp-action="Login">Log in</a><a class="btn btn-dark btn-small" asp-controller="Account" asp-action="Register">Create account</a> }
    </div>
</div></header>
<main>@RenderBody()</main>
<footer class="footer"><div class="footer-inner"><a class="brand footer-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">S</span><span>stay<span class="brand-light">ease</span></span></a><p>Make room for a better getaway.</p><span>© @DateTime.Now.Year StayEase · Academic project</span></div></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
