@model IEnumerable<Room>
@{ ViewData["Title"] = "Find your next stay"; }
<section class="hero"><div class="hero-shade"></div><div class="hero-content"><span class="eyebrow hero-eyebrow">A STAY THAT FEELS LIKE YOU</span><h1>Somewhere<br/><em>good begins.</em></h1><p>Thoughtful spaces, little luxuries, and stays worth slowing down for.</p><a class="btn btn-cream" href="#stays">Explore our stays <span>↘</span></a></div><div class="hero-note"><span class="note-line"></span><span>MAKE YOURSELF AT HOME</span></div></section>
<section class="intro-strip"><div><span class="eyebrow">THE STAYEASE DIFFERENCE</span><h2>Not just a room.<br/>A feeling.</h2></div><p>From slow mornings to city adventures, find a space that makes the whole trip feel a little more special.</p><div class="perks"><span>✳ Thoughtfully picked</span><span>✳ Easy booking</span><span>✳ Comfort first</span></div></section>
<section class="stays-section" id="stays"><div class="section-heading"><div><span class="eyebrow">YOUR NEXT CHAPTER</span><h2>Find your kind of stay</h2></div><span class="stay-count">@Model.Count() handpicked rooms</span></div>
<div class="room-grid">
@foreach (var room in Model) { <article class="room-card"><div class="room-image-wrap"><img class="room-image" src="@room.ImageUrl" alt="@room.Name" loading="lazy"/><span class="room-badge">@room.Badge</span><span class="image-index">STAYEASE · 0@room.Id</span></div><div class="room-info"><div class="room-category">@room.Category <span>·</span> Up to @room.Capacity guests</div><h3>@room.Name</h3><p class="room-description">@room.Description</p><div class="room-bottom"><div class="price"><strong>₹@room.PricePerNight.ToString("N0")</strong><span>/ night</span></div><a class="btn btn-dark book-btn" asp-controller="Bookings" asp-action="Create" asp-route-roomId="@room.Id">Book stay <span>↗</span></a></div></div></article> }
</div></section>
<section class="closing-cta"><div><span class="eyebrow">YOUR TIME AWAY STARTS HERE</span><h2>Take the scenic route.</h2><p>Your next favourite place is closer than you think.</p></div><a class="btn btn-cream" href="#stays">Find your stay <span>↗</span></a></section>
