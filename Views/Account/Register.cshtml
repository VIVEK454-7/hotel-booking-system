@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="auth-page"><div class="auth-image register-image"><div class="auth-image-copy"><span class="eyebrow">A LITTLE SPACE FOR YOU</span><h2>Good stays.<br/><em>Better stories.</em></h2><p>Make your next getaway one to remember.</p></div></div><div class="auth-panel"><div class="auth-form-wrap"><span class="eyebrow">WELCOME TO STAYEASE</span><h1>Create your account</h1><p class="form-subtitle">Save your details and make booking your next stay simple.</p><form asp-action="Register" method="post" class="form-stack"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="FullName">Full name</label><input asp-for="FullName" placeholder="Your name" autocomplete="name"/><span asp-validation-for="FullName" class="field-error"></span><label asp-for="Email">Email address</label><input asp-for="Email" placeholder="you@example.com" autocomplete="email"/><span asp-validation-for="Email" class="field-error"></span><label asp-for="Password">Password</label><input asp-for="Password" placeholder="At least 8 characters" autocomplete="new-password"/><span asp-validation-for="Password" class="field-error"></span><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" placeholder="Repeat your password" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="field-error"></span><button class="btn btn-dark btn-wide" type="submit">Create account <span>↗</span></button></form><p class="auth-switch">Already have an account? <a asp-action="Login">Log in</a></p><p class="fine-print">Academic demo application. Use a unique password, not one used for important accounts.</p></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
