@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<section class="auth-page"><div class="auth-image login-image"><div class="auth-image-copy"><span class="eyebrow">LEAVE THE EVERYDAY BEHIND</span><h2>Your next escape<br/><em>is waiting.</em></h2><p>Come back to the places that make you feel good.</p></div></div><div class="auth-panel"><div class="auth-form-wrap"><span class="eyebrow">WELCOME BACK</span><h1>Log in to StayEase</h1><p class="form-subtitle">Your next getaway is only a few clicks away.</p><form asp-action="Login" method="post" class="form-stack"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Email">Email address</label><input asp-for="Email" placeholder="you@example.com" autocomplete="email"/><span asp-validation-for="Email" class="field-error"></span><label asp-for="Password">Password</label><input asp-for="Password" placeholder="Your password" autocomplete="current-password"/><span asp-validation-for="Password" class="field-error"></span><button class="btn btn-dark btn-wide" type="submit">Log in <span>↗</span></button></form><p class="auth-switch">New to StayEase? <a asp-action="Register">Create an account</a></p></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
